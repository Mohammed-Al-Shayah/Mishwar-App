rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && ('admin' in request.auth.token) && request.auth.token.admin == true; }
    match /shares/{document=**} { allow read, write: if false; }
    match /promos/{document=**} { allow read: if isAdmin(); allow write: if false; }
    match /users/{uid}/meta/{document=**} { allow read, write: if false; }
    match /config/{id} { allow read: if isAdmin() || (id == 'app' && request.auth != null); allow write: if false; }
    match /banners/{id} { allow read: if request.auth != null; allow write: if false; }
    match /adminLog/{id} { allow read: if isAdmin(); allow write: if false; }
    match /supportTickets/{ticketId} {
      function owner() { return request.auth != null && resource.data.uid == request.auth.uid; }
      allow read: if owner() || isAdmin();
      allow create, delete: if false;
      allow update: if owner() && !isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userUnread'])
        && request.resource.data.userUnread == false;
      match /messages/{messageId} {
        function ticket() { return get(/databases/$(database)/documents/supportTickets/$(ticketId)).data; }
        function ownsTicket() { return request.auth != null && ticket().uid == request.auth.uid; }
        allow read: if ownsTicket() || isAdmin();
        allow create: if ownsTicket() && !isAdmin() && ticket().status != 'closed'
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['from', 'text', 'createdAt'])
          && request.resource.data.from == 'user'
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      match /trustedContacts/{contactId} {
        function validContact() {
          let data = request.resource.data;
          return data.keys().hasOnly(['name', 'phone', 'createdAt'])
            && data.keys().hasAll(['name', 'phone', 'createdAt'])
            && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
            && data.phone is string && data.phone.size() <= 20
            && data.phone.matches('^[+][1-9][0-9]{1,14}$')
            && data.createdAt == request.time;
        }
        allow read: if isOwner() || isAdmin();
        allow create, update: if isOwner() && validContact();
        allow delete: if isOwner();
      }
      match /savedPlaces/{placeId} {
        function validSavedPlace() {
          let data = request.resource.data;
          return data.keys().hasOnly(['label', 'name', 'address', 'geopoint', 'updatedAt'])
            && data.keys().hasAll(['label', 'name', 'address', 'geopoint', 'updatedAt'])
            && data.label in ['home', 'work', 'other']
            && ((data.label == 'home' && placeId == 'home')
              || (data.label == 'work' && placeId == 'work')
              || (data.label == 'other' && !(placeId in ['home', 'work'])))
            && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
            && data.address is string && data.address.size() <= 200
            && data.geopoint is latlng
            && data.updatedAt == request.time;
        }
        allow read: if isOwner() || isAdmin();
        allow create, update: if isOwner() && !isAdmin() && validSavedPlace();
        allow delete: if isOwner() && !isAdmin();
      }

      // Clients may only self-assign rider or driver; admin is set server-side
      // via custom claims / Admin SDK, never from the app.
      function validClientRole() {
        return !('role' in request.resource.data)
          || request.resource.data.role in ['rider', 'driver'];
      }

      function validPushToken() {
        let data = request.resource.data;
        return (!('fcmToken' in data)
            || data.fcmToken == null
            || (data.fcmToken is string && data.fcmToken.size() <= 4096))
          && (!('fcmTokenUpdatedAt' in data)
            || data.fcmTokenUpdatedAt == request.time);
      }
      function validProfile() {
        let data = request.resource.data;
        return (!('name' in data)
            || (data.name is string && data.name.size() >= 2 && data.name.size() <= 40))
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
          && (!('photoUrl' in data) || data.photoUrl == null
            || (data.photoUrl is string && data.photoUrl.size() <= 2048));
      }
      function validPushUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(['fcmToken', 'fcmTokenUpdatedAt'])
          || (validPushToken()
            && request.resource.data.fcmTokenUpdatedAt == request.time);
      }
      allow read: if isAdmin() || isOwner();
      allow create: if !isAdmin() && isOwner() && validClientRole() && validProfile() && validPushToken()
        && request.resource.data.keys().hasOnly(
          ['name', 'phone', 'role', 'photoUrl', 'createdAt', 'fcmToken', 'fcmTokenUpdatedAt'])
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
        && (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken == null
          || request.resource.data.fcmTokenUpdatedAt == request.time)
        && !request.resource.data.keys().hasAny(['activeRideId', 'pendingRatingRideId', 'rating', 'ratingCount', 'accountDeleting', 'balanceDueFils']);
      allow update: if !isAdmin() && isOwner()
        && validClientRole() && validProfile() && validPushUpdate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['name', 'phone', 'photoUrl', 'role', 'fcmToken', 'fcmTokenUpdatedAt'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeRideId', 'pendingRatingRideId', 'rating', 'ratingCount', 'accountDeleting', 'balanceDueFils'])
        && (!('role' in resource.data)
          || ('role' in request.resource.data
            && request.resource.data.role == resource.data.role));
      // Prevent deletion and recreation to change an existing role.
      allow delete: if !isAdmin() && isOwner() && !('role' in resource.data);
    }

    match /drivers/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function boundedString(value, maximum) {
        return value is string && value.size() > 0 && value.size() <= maximum;
      }
      function validApplication() {
        let data = request.resource.data;
        return data.vehicle is map
          && data.vehicle.keys().hasOnly(['type', 'make', 'model', 'color', 'plate'])
          && data.vehicle.type in ['economy', 'comfort', 'van']
          && boundedString(data.vehicle.make, 40) && boundedString(data.vehicle.model, 40)
          && boundedString(data.vehicle.color, 40) && boundedString(data.vehicle.plate, 15)
          && data.licensePhotoPath is string
          && data.licensePhotoPath.size() <= 1024
          && data.licensePhotoPath.matches('^drivers/[^/]+/[^/]+$')
          && data.licensePhotoPath.split('/')[1] == uid;
      }
      allow read: if isAdmin() || isOwner();
      allow create: if !isAdmin() && isOwner() && validApplication()
        && request.resource.data.keys().hasOnly(
          ['vehicle', 'licensePhotoPath', 'status', 'isOnline', 'createdAt', 'updatedAt'])
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time)
        && request.resource.data.status == 'pending'
        && request.resource.data.isOnline == false
        && !('offer' in request.resource.data)
        && !request.resource.data.keys().hasAny(['currentRideId', 'pendingRatingRideId', 'cancelCount']);
      allow update: if !isAdmin() && isOwner() && validApplication()
        && resource.data.status in ['pending', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['vehicle', 'licensePhotoPath', 'updatedAt', 'status'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time)
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'));
      // Approved drivers may update presence only; assignments stay server-owned.
      allow update: if !isAdmin() && isOwner() && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['isOnline', 'location', 'heading', 'lastSeenAt'])
        && request.resource.data.isOnline is bool
        && request.resource.data.location is map
        && request.resource.data.location.keys().hasOnly(['geohash', 'geopoint'])
        && request.resource.data.location.geohash is string
        && request.resource.data.location.geohash.size() >= 1
        && request.resource.data.location.geohash.size() <= 12
        && request.resource.data.location.geopoint is latlng
        && (!('heading' in request.resource.data)
          || (request.resource.data.heading is number
            && request.resource.data.heading >= 0
            && request.resource.data.heading <= 360))
        && request.resource.data.lastSeenAt == request.time
        && (request.resource.data.isOnline == resource.data.isOnline
          || !request.resource.data.isOnline
          || !('currentRideId' in resource.data)
          || resource.data.currentRideId == null);
      allow delete: if false;
      match /earnings/{day} {
        allow read: if isAdmin() || isOwner();
        allow write: if false;
      }
    }

    match /rides/{rideId} {
      allow get: if isAdmin() || (request.auth != null && (request.auth.uid == resource.data.riderId
        || resource.data.get('driverId', null) == request.auth.uid
        || resource.data.get('offeredTo', null) == request.auth.uid));
      // Rules are not filters: history queries must prove one of these equalities.
      // Offers are fetched by document ID, never by a client collection query.
      allow list: if isAdmin() || (request.auth != null
        && (resource.data.riderId == request.auth.uid
          || resource.data.get('driverId', null) == request.auth.uid));
      allow create, update, delete: if false;
      match /live/driver {
        function ride() { return get(/databases/$(database)/documents/rides/$(rideId)).data; }
        allow read: if isAdmin() || request.auth != null
          && request.auth.uid in [ride().riderId, ride().get('driverId', null)];
        allow create, update: if !isAdmin() && request.auth != null
          && request.auth.uid == ride().get('driverId', null)
          && ride().status in ['accepted', 'arriving', 'arrived', 'in_progress']
          && request.resource.data.keys().hasOnly(['geopoint', 'heading', 'updatedAt'])
          && request.resource.data.geopoint is latlng
          && request.resource.data.updatedAt == request.time
          && (!('heading' in request.resource.data)
            || (request.resource.data.heading is number
              && request.resource.data.heading >= 0 && request.resource.data.heading <= 360));
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
